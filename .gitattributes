# Normalize text files so Windows and GitHub contributors get consistent diffs.
* text=auto

*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.addin text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Images and compiled assets are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

