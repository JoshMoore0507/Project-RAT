<Window x:Class="TPMechanical.QAQC.HangerPlacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TP Mechanical - Hanger Placement"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D5D9DE"
                BorderThickness="0,0,0,1"
                Padding="16">

            <StackPanel Orientation="Horizontal">

                <Border Width="48"
                        Height="48"
                        Background="#1565C0"
                        CornerRadius="4"
                        Margin="0,0,12,0">

                    <TextBlock Text="TP"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="TP Mechanical"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Hanger Placement"
                               FontSize="13"
                               Foreground="#666666"/>

                </StackPanel>

            </StackPanel>

        </Border>


        <!-- MAIN TABS -->
        <TabControl
    Grid.Row="1"
    Margin="12"
    Background="White"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">


            <TabItem Header="Hanger Configuration"
         HorizontalContentAlignment="Stretch"
         VerticalContentAlignment="Stretch">

                <Grid Margin="15"
          ClipToBounds="True">

                    <Grid.RowDefinitions>
                        <!-- Description -->
                        <RowDefinition Height="Auto"/>

                        <!-- Rule table -->
                        <RowDefinition Height="*"/>

                        <!-- Management buttons -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ======================================= -->
                    <!-- DESCRIPTION -->
                    <!-- ======================================= -->

                    <TextBlock
            Grid.Row="0"
            Text="Define TP Mechanical hanger placement rules."
            FontSize="14"
            Foreground="#555555"
            Margin="0,0,0,12"/>


                    <!-- ======================================= -->
                    <!-- SCROLLABLE RULE TABLE -->
                    <!-- ======================================= -->

                    <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible"
            CanContentScroll="False">

                        <DataGrid
                x:Name="HangerRulesGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="True"
                CanUserDeleteRows="True"
                HeadersVisibility="Column"
                GridLinesVisibility="All"

                MinWidth="1900"
                MinHeight="400"

                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <DataGrid.Columns>

                                <DataGridCheckBoxColumn
    Header="Use"
    Binding="{Binding Use}"
    Width="60"/>


                                <DataGridComboBoxColumn
    x:Name="TypeColumn"
    Header="Type"
    SelectedItemBinding="{Binding Type,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
    Width="150"/>


                                <DataGridComboBoxColumn
    x:Name="ServiceColumn"
    Header="Service"
    SelectedItemBinding="{Binding Service,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
    Width="180"/>


                                <DataGridComboBoxColumn
    x:Name="MaterialColumn"
    Header="Material"
    SelectedItemBinding="{Binding Material,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
    Width="160"/>


                                <DataGridComboBoxColumn
    x:Name="SizeByColumn"
    Header="Size By"
    SelectedItemBinding="{Binding SizeBy,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
    Width="120"/>


                                <DataGridTextColumn
    Header="Size &lt;="
    Binding="{Binding SizeLessThanOrEqual,
                      Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}"
    Width="100"/>


                                <DataGridTextColumn
    Header="Spacing"
    Binding="{Binding Spacing,
                      Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}"
    Width="100"/>


                                <DataGridTextColumn
    Header="From End"
    Binding="{Binding FromEnd,
                      Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}"
    Width="110"/>


                                <DataGridTextColumn
    Header="From Joint"
    Binding="{Binding FromJoint,
                      Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}"
    Width="110"/>


                                <DataGridTextColumn
    Header="From Branch/Tap"
    Binding="{Binding FromBranchTap,
                      Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}"
    Width="150"/>


                                <DataGridComboBoxColumn
    x:Name="HangerTypeColumn"
    Header="Hanger Type"
    SelectedItemBinding="{Binding HangerType,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
    Width="170"/>


                                <DataGridTextColumn
    Header="Hanger w/ Insulation"
    Binding="{Binding HangerWithInsulation,
                      Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}"
    Width="190"/>


                                <DataGridTextColumn
    Header="Pending Action"
    Binding="{Binding PendingAction}"
    IsReadOnly="True"
    Width="150"/>


                                <DataGridTextColumn
    Header="Error Message"
    Binding="{Binding ErrorMessage}"
    IsReadOnly="True"
    Width="220"/>
                            </DataGrid.Columns>

                        </DataGrid>

                    </ScrollViewer>


                    <!-- ======================================= -->
                    <!-- RULE MANAGEMENT BAR -->
                    <!-- ======================================= -->

                    <Border
            Grid.Row="2"
            BorderBrush="#D5D9DE"
            BorderThickness="0,1,0,0"
            Margin="0,8,0,0"
            Padding="0,10,0,0">

                        <DockPanel>

                            <!-- LEFT SIDE BUTTONS -->

                            <StackPanel
                    Orientation="Horizontal"
                    DockPanel.Dock="Left">

                                <Button
                        Content="+ Add Rule"
                        Width="100"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="AddRule_Click"/>

                                <Button
                        Content="Delete Rule"
                        Width="100"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="DeleteRule_Click"/>

                                <Button
                        Content="Duplicate Rule"
                        Width="115"
                        Height="32"
                        Margin="0,0,15,0"
                        Click="DuplicateRule_Click"/>

                                <Button
                        Content="↑"
                        Width="38"
                        Height="32"
                        Margin="0,0,5,0"
                        ToolTip="Move selected rule up"
                        Click="MoveUp_Click"/>

                                <Button
                        Content="↓"
                        Width="38"
                        Height="32"
                        ToolTip="Move selected rule down"
                        Click="MoveDown_Click"/>

                            </StackPanel>


                            <!-- RIGHT SIDE BUTTON -->

                            <Button
                    DockPanel.Dock="Right"
                    Content="Reset to TP Defaults"
                    Width="150"
                    Height="32"
                    HorizontalAlignment="Right"
                    Click="ResetDefaults_Click"/>

                        </DockPanel>

                    </Border>

                </Grid>

            </TabItem>

            <!-- HANGER OPTIONS -->
            <TabItem Header="Hanger Options">

                <Grid Margin="20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="Collision Adjustment"
                              Padding="18">

                        <StackPanel>

                            <CheckBox
                                Content="Enable Collision Adjustment"
                                IsChecked="True"
                                FontWeight="SemiBold"
                                Margin="0,0,0,18"/>

                            <TextBlock Text="Movement Interval"/>

                            <TextBox
                                Text="4&quot;"
                                Height="30"
                                Margin="0,5,0,14"/>

                            <TextBlock Text="Tolerance"/>

                            <ComboBox
                                Height="30"
                                SelectedIndex="1"
                                Margin="0,5,0,14">

                                <ComboBoxItem Content="1&quot;"/>
                                <ComboBoxItem Content="2&quot;"/>
                                <ComboBoxItem Content="4&quot;"/>

                            </ComboBox>

                            <TextBlock Text="Maximum Movement"/>

                            <TextBox
                                Text="4'-0&quot;"
                                Height="30"
                                Margin="0,5,0,14"/>

                            <TextBlock Text="Ignore CID / Name"/>

                            <TextBox
                                Height="30"
                                Margin="0,5,0,18"/>

                            <CheckBox
                                Content="Highlight immovable hangers"
                                IsChecked="True"/>

                        </StackPanel>

                    </GroupBox>


                    <GroupBox Grid.Column="2"
                              Header="Collision Logic"
                              Padding="18">

                        <StackPanel>

                            <TextBlock
                                Text="When a hanger clashes with model geometry, TP Hanger Placement will attempt to move the hanger until a valid location is found."
                                TextWrapping="Wrap"
                                FontSize="14"
                                Foreground="#555555"/>

                            <Border Background="#EEF2F6"
                                    CornerRadius="5"
                                    Padding="15"
                                    Margin="0,20,0,0">

                                <TextBlock
                                    Text="1. Calculate ideal hanger location&#x0a;2. Check for collision&#x0a;3. Move by configured interval&#x0a;4. Check again&#x0a;5. Continue until clear or maximum movement is reached&#x0a;6. Highlight unresolved hanger"
                                    LineHeight="24"/>

                            </Border>

                        </StackPanel>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- POINT CONFIGURATION -->
            <TabItem Header="Point Configuration">

                <StackPanel
                    Margin="25"
                    Width="500"
                    HorizontalAlignment="Left">

                    <TextBlock
                        Text="Automatic Layout Point Configuration"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Margin="0,0,0,20"/>

                    <CheckBox
                        Content="Automatically place point when hanger is placed"
                        Margin="0,0,0,18"/>

                    <TextBlock Text="Point Family"/>

                    <ComboBox
                        Height="32"
                        Margin="0,5,0,15">

                        <ComboBoxItem
                            Content="TP Layout Point"/>

                    </ComboBox>

                    <TextBlock Text="Point Location"/>

                    <ComboBox
                        Height="32"
                        SelectedIndex="0"
                        Margin="0,5,0,15">

                        <ComboBoxItem
                            Content="Hanger Center"/>

                        <ComboBoxItem
                            Content="Rod Center"/>

                        <ComboBoxItem
                            Content="Host Centerline"/>

                    </ComboBox>

                </StackPanel>

            </TabItem>


            <!-- POINT OPTIONS -->
            <TabItem Header="Point Options">

                <StackPanel
                    Margin="25"
                    Width="500"
                    HorizontalAlignment="Left">

                    <TextBlock
                        Text="Trimble Point Options"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Margin="0,0,0,20"/>

                    <CheckBox
                        Content="Automatically number points"
                        IsChecked="True"
                        Margin="0,0,0,15"/>

                    <TextBlock Text="Point Prefix"/>

                    <TextBox
                        Text="H-"
                        Height="30"
                        Margin="0,5,0,15"/>

                    <CheckBox
                        Content="Store source hanger Element ID"
                        IsChecked="True"
                        Margin="0,0,0,15"/>

                    <CheckBox
                        Content="Include points in TP point export"
                        IsChecked="True"/>

                </StackPanel>

            </TabItem>


        </TabControl>


        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D5D9DE"
                BorderThickness="0,1,0,0"
                Padding="12">

            <DockPanel>

                <TextBlock
                    Text="TP Mechanical Hanger Placement"
                    VerticalAlignment="Center"
                    Foreground="#666666"/>

                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">

                    <Button
                        Content="Place Hangers"
                        Width="125"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="PlaceHangers_Click"/>

                    <Button
                        Content="Close"
                        Width="90"
                        Height="36"
                        Click="Close_Click"/>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>

</Window>